<h1><%= Icon icon: "link-45deg", role: "presentation" %> Link to Printables</h1>
<p><strong><%= @model.name %></strong></p>
<% if @error %>
  <div class="alert alert-danger" role="alert"><%= @error %></div>
<% end %>
<% unless @configured %>
  <p>Enable Printables under <%= link_to "Settings > Integrations", main_app.integrations_settings_path %>.</p>
<% end %>
<section id="printables-search-matches" class="mb-4">
  <h2 class="h4">Search Printables</h2>
  <%= form_with url: manyfold_printables.link_path, method: :get, id: "printables-match-form" do |form| %>
    <%= form.hidden_field :model_id, value: @model.to_param, id: nil %>
    <%= form.hidden_field :source, value: @source, id: nil if @source.present? %>
    <%= form.label :match_q, "Search Printables", class: "form-label" %>
    <div class="input-group">
      <%= form.search_field :match_q, value: @match_query, maxlength: 200, class: "form-control" %>
      <%= form.submit "Find matches", class: "btn btn-outline-primary", disabled: !@configured %>
    </div>
  <% end %>
  <% if @match_error %>
    <p><%= @match_error %></p>
  <% elsif @matches.empty? %>
    <p>No close matches found.</p>
  <% else %>
    <ul class="list-group mt-3">
      <% @matches.each do |item| %>
        <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
          <div>
            <strong><%= item.fetch("name") %></strong>
            <% if item.fetch("creator_name").present? %><div><%= item.fetch("creator_name") %></div><% end %>
            <div class="small">Printables ID <%= item.fetch("id") %></div>
          </div>
          <%= link_to "Use this model", manyfold_printables.link_path(model_id: @model.to_param, source: item.fetch("id"), match_q: @match_query, anchor: "printables-link-form"), class: "btn btn-outline-primary", aria: {label: "Use #{item.fetch('name')}"} %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
<%= form_with url: manyfold_printables.link_path, method: :post, id: "printables-link-form" do |form| %>
  <%= form.hidden_field :model_id, value: @model.to_param, id: nil %>
  <%= form.hidden_field :match_q, value: @match_query, id: nil %>
  <div class="mb-3">
    <%= form.label :source, "Printables model URL or ID", class: "form-label" %>
    <%= form.text_field :source, value: @source, required: true, class: "form-control" %>
  </div>
  <%= form.submit "Link and sync", class: "btn btn-primary", disabled: !@configured %>
  <%= link_to "Cancel", main_app.model_path(@model), class: "btn btn-secondary" %>
<% end %>
