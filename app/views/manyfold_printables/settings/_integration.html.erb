<%= Accordion(title: "Printables #{ManyfoldPrintables::ApiClient.configured? ? "\u2705" : "\u274c"}", id: "printables-integration") do %>
  <p>Link public Printables models and sync their details and images. No account credentials are required.</p>
  <div class="form-check mb-3">
    <%= form.check_box "integrations[printables_enabled]", checked: SiteSettings.printables_enabled, class: "form-check-input" %>
    <%= form.label "integrations[printables_enabled]", "Enable Printables linking and sync", class: "form-check-label" %>
  </div>
<% end %>
