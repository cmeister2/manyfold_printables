#!/usr/bin/env sh
set -eu

plugin_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
source_root=$(CDPATH= cd -- "$1" && pwd)

docker run --rm --pull=missing --network none \
  --entrypoint /plugins/manyfold_printables/test/run \
  --mount "type=bind,source=$source_root,target=/plugins/manyfold_printables,readonly" \
  --mount "type=bind,source=$plugin_root/test,target=/plugins/manyfold_printables/test,readonly" \
  --tmpfs /config \
  --env PLUGINS_PATH=/plugins \
  --env DATABASE_URL=sqlite3:/config/manyfold.sqlite3 \
  --env REDIS_URL=redis://127.0.0.1:6379/1 \
  --env MULTIUSER=enabled \
  --env MANYFOLD_LOG_LEVEL=warn \
  --env SECRET_KEY_BASE=manyfold-printables-disposable-local-test-secret-with-no-real-data \
  --env MANYFOLD_PRINTABLES_TEST=1 \
  --env "MANYFOLD_PRINTABLES_EXPECTED_VERSION=${2:-}" \
  manyfold3d/manyfold-solo:0.146.0
